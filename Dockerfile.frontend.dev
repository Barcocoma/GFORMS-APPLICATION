FROM node:20-alpine

WORKDIR /app

# Install pnpm
RUN npm install -g pnpm@10.14.0

# Copy package files
COPY package.json pnpm-lock.yaml ./

# Install dependencies
RUN pnpm install --frozen-lockfile

# Expose Vite dev server port
EXPOSE 8080

# Start development server
CMD ["pnpm", "dev", "--host", "0.0.0.0"]

